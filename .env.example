# Copie ce fichier en .env (make init). Ne commite JAMAIS .env.
ENVIRONMENT=development
POSTGRES_USER=foodbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foodbridge
# Port Postgres exposé sur ta machine (5432 est souvent réservé sous Windows)
POSTGRES_HOST_PORT=5433
# Génère une vraie clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me

# Pays par défaut des numéros saisis sans indicatif (code ISO à 2 lettres : FR, SN, BE...)
DEFAULT_PHONE_REGION=FR

# Anti-abus (valeurs par défaut)
# MAX_ACTIVE_CLAIMS=3
# MAX_NO_SHOWS=3
# En production : n'autoriser que les organisations vérifiées par un admin à réserver
# REQUIRE_VERIFIED_CLAIMANTS=true
